# === DressingAI — Variables d'environnement ===
# Copie ce fichier en `.env.local` et remplis les valeurs.
# L'app fonctionne en MODE DÉMO (données fictives) tant que ces clés sont vides.

# --- Supabase (auth, database, storage) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Anthropic Claude (vision IA + styliste) ---
# Deux façons d'activer l'IA (choisis-en UNE) :
#
# A. SÉCURISÉ (recommandé) — via l'Edge Function Supabase `claude` :
#    la clé reste côté serveur. Déploie supabase/functions/claude, mets le
#    secret ANTHROPIC_API_KEY dans Supabase, puis active le proxy ici :
VITE_CLAUDE_PROXY=
#    → mets VITE_CLAUDE_PROXY=1 (et laisse VITE_ANTHROPIC_API_KEY vide).
#
# B. RAPIDE (moins sûr) — appel direct depuis le navigateur : la clé est
#    incluse dans le bundle (extractible). Pour test/usage perso seulement.
VITE_ANTHROPIC_API_KEY=
VITE_CLAUDE_MODEL=claude-sonnet-5

# --- OpenWeatherMap (météo géolocalisée) ---
VITE_OPENWEATHER_API_KEY=

# --- Affiliation (monétisation "Shopper un look") ---
# Les liens boutiques marchent sans ; les commissions s'activent avec tes IDs.
VITE_AMAZON_TAG=        # Amazon Partenaires, ex: dressingai-21
VITE_AWIN_ID=           # ID éditeur Awin (Shein, Zalando, ASOS…)
