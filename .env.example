# === Dressify — Variables d'environnement ===
# Copie ce fichier en `.env.local` et remplis les valeurs.
# L'app fonctionne en MODE DÉMO (données fictives) tant que ces clés sont vides.

# --- Supabase (auth, database, storage) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Anthropic Claude (vision IA + styliste) ---
# ⚠️ En production, proxifie ces appels côté serveur pour ne pas exposer la clé.
VITE_ANTHROPIC_API_KEY=
VITE_CLAUDE_MODEL=claude-sonnet-4-6

# --- OpenWeatherMap (météo géolocalisée) ---
VITE_OPENWEATHER_API_KEY=
